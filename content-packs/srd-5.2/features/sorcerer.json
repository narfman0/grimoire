    "slug": "innate-sorcery",
    "version": 1,
    "name": "Innate Sorcery",
    "data": {
      "description": "As a Bonus Action, you can unleash the sorcerous power within you. For 1 minute, your Spell Save DC increases by 1 and you have Advantage on spell attack rolls. You can use this feature twice, regaining all expended uses on a Long Rest.",
      "ownerKind": "class",
      "ownerSlug": "sorcerer",
      "minLevel": 1,
      "note": "2024 SRD 5.2 Innate Sorcery (replaces 2014's Sorcerous Restoration as the L1 capstone trait): bonus action, lasts 1 minute, twice per long rest (recovers one use on a short rest at higher levels — engine extension needed). While active: your Spell Save DC is +1 and you have Advantage on Spell attack rolls you make. v0 surfaces the activity with a 2/long-rest uses block and a passive +1 to spell DC; the duration-gated advantage on spell attacks is left as a tagged effect for the UI (advantage isn't a first-class action target in the engine yet).",
      "activities": [
        {
          "id": "innate-sorcery",
          "type": "utility",
          "name": "Innate Sorcery",
          "cost": "bonus",
