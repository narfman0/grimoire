    "name": "Weapon Mastery (Rogue)",
    "data": {
      "ownerKind": "class",
      "ownerSlug": "rogue",
      "minLevel": 1,
      "note": "Choose 2 kinds of weapons you have proficiency with to apply their mastery property. You can change one chosen weapon when you finish a long rest. Mastery properties (Cleave/Graze/Nick/Push/Sap/Slow/Topple/Vex) aren't yet first-class targets in the engine; surfaced as a choice.",
      "choice": {
        "kind": "weapon-mastery",
