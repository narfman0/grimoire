  {
    "kind": "feature",
    "slug": "death-strike",
    "version": 1,
    "name": "Death Strike",
    "data": {
      "ownerKind": "class",
      "ownerSlug": "rogue",
      "minLevel": 20,
      "modifiers": [
        {
          "kind": "action-modifier",
          "id": "death-strike-toggle",
          "name": "Death Strike",
          "defaultEnabled": false,
          "appliesTo": {
            "activityType": "attack",
            "predicates": [
              {
                "or": [
                  { "weapon.property": "finesse" },
                  { "attack.range": "ranged" }
                ]
              },
              { "condition": "target.surprised" }
            ]
          },
          "effects": [
            {
              "target": "tag.death-strike",
              "mode": "OVERRIDE",
              "value": true
            }
          ]
        }
      ],
      "note": "When you hit a Surprised creature with an attack and deal Sneak Attack damage to it, the creature must make a CON saving throw (DC 8 + DEX modifier + PB). On a failed save, the damage of your attack is doubled. v0 tags the effect; the conditional damage-doubling and the CON save aren't simulated by the evaluator. Surfaced as a toggle for DM/player adjudication."
    }
  }
