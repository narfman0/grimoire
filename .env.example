# Copy this file to .env and fill in the values before running.
#
#   cp .env.example .env

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Required in production for account verification and password reset emails.
# Without it, email bodies are printed to the server console instead.
# Get a key at https://resend.com
RESEND_API_KEY=

# The "From" address on outgoing emails.
# Must be a verified sender domain in your Resend account.
FROM_EMAIL=noreply@grimoire.app

# ── Database ──────────────────────────────────────────────────────────────────
# Path to the SQLite database file (relative or absolute).
# Defaults to ./grimoire.db when unset.
DATABASE_URL=grimoire.db

# ── Content packs ─────────────────────────────────────────────────────────────
# Path to a directory of non-SRD content packs to load at boot.
# Defaults to ../grimoire-packs when unset; leave blank to skip.
GRIMOIRE_PACKS_DIR=

# ── Admin bootstrap ───────────────────────────────────────────────────────────
# Username to promote to admin on each server boot.
# Defaults to "narfman0" when unset.
ADMIN_USERNAME=

# ── SvelteKit / Node ──────────────────────────────────────────────────────────
# Must be set in production so SvelteKit can validate CSRF origins.
# Set to the public URL of the app (e.g. https://grimoire.example.com).
ORIGIN=http://localhost:5173

# Set to "production" in prod deployments.
NODE_ENV=development
