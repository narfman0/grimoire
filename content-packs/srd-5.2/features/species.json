  {
    "kind": "feature",
    "slug": "breath-weapon",
    "version": 1,
    "name": "Breath Weapon",
    "data": {
      "ownerKind": "species",
      "ownerSlug": "dragonborn",
      "note": "SRD 5.2: 15-ft cone or 30-ft line (per ancestry). DC = 8 + Con mod + PB. Damage scales by total level: 1d10 (L1-4), 2d10 (L5-10), 3d10 (L11-16), 4d10 (L17-20) via perTotalLevel table. Damage type follows trait.draconic-ancestry. Usable PB times per long rest.",
      "activities": [
        {
          "id": "breath-weapon",
          "type": "save",
          "name": "Breath Weapon",
          "cost": "action",
          "range": { "value": 15, "units": "ft" },
          "save": { "ability": "dex", "dc": { "calc": "custom", "base": 8, "bonus": ["conMod", "proficiencyBonus"] } },
          "damage": {
            "parts": [{
              "dice": { "perTotalLevel": true, "table": ["1d10","1d10","1d10","1d10","2d10","2d10","2d10","2d10","2d10","2d10","3d10","3d10","3d10","3d10","3d10","3d10","4d10","4d10","4d10","4d10"] },
              "type": "varies"
            }]
          },
          "uses": { "max": "proficiencyBonus", "per": "long-rest" }
        }
      ]
    }
  },
