  {
    "kind": "feature",
    "slug": "uncanny-dodge",
    "version": 1,
    "name": "Uncanny Dodge",
    "data": {
      "ownerKind": "class",
      "ownerSlug": "rogue",
      "minLevel": 5,
      "note": "Reaction: when an attacker you can see hits you with an attack roll, halve the attack's damage against you (you choose to use this after the hit is confirmed). v0 doesn't yet model damage reduction as a target the engine can apply; surfaced as a declarative trigger so the UI can prompt the player.",
      "triggers": [
        {
          "kind": "trigger",
          "id": "uncanny-dodge",
          "name": "Uncanny Dodge",
          "on": ["self.hit-by-attack"],
          "scope": {
            "predicates": [
              { "attack.attacker.visible": true }
            ]
          },
          "grants": {
            "effect": "damage.halve-incoming",
            "cost": "reaction"
          }
        }
      ]
    }
  },
