    "version": 1,
    "name": "Expertise (Rogue)",
    "data": {
      "ownerKind": "class",
      "ownerSlug": "rogue",
      "minLevel": 1,
      "note": "Choose 2 proficient skills to gain Expertise (doubled proficiency bonus). Engine emits two expertise.skill.<slug> modifiers. Rogue 6 grants a second pick of 2 more skills (expertise-rogue-l6).",
      "choices": {
        "expertises": {
          "allowedSkills": "proficient",
          "pick": 2
        }
      }
    }
  },
  {
    "kind": "feature",
    "slug": "sneak-attack",
    "version": 1,
    "name": "Sneak Attack",
    "data": {
      "ownerKind": "class",
      "ownerSlug": "rogue",
      "minLevel": 1,
      "note": "2024 SRD 5.2 Sneak Attack: once per turn, when you hit with an attack roll using a Finesse or Ranged weapon and either you have Advantage or an ally of the target is within 5 ft of it (and you don't have Disadvantage), deal extra damage. Scales by rogue level: [1d6,1d6,2d6,2d6,3d6,3d6,4d6,4d6,5d6,5d6,6d6,6d6,7d6,7d6,8d6,8d6,9d6,9d6,10d6,10d6]. v0 models the dice value as a perClass table; once-per-turn enforcement and advantage/ally-adjacency gating require engine extension.",
      "modifiers": [
        {
          "kind": "action-modifier",
          "id": "sneak-attack-damage",
          "name": "Sneak Attack",
          "defaultEnabled": true,
          "appliesTo": {
            "activityType": "attack",
            "predicates": [
              {
                "or": [
                  { "weapon.property": "finesse" },
                  { "attack.range": "ranged" }
                ]
              }
            ]
          },
          "effects": [
            {
              "target": "damage.bonus",
              "mode": "ADD",
              "value": {
                "perClass": "rogue",
                "table": [
                  "1d6",
                  "1d6",
                  "2d6",
                  "2d6",
                  "3d6",
                  "3d6",
                  "4d6",
                  "4d6",
                  "5d6",
                  "5d6",
                  "6d6",
                  "6d6",
                  "7d6",
                  "7d6",
                  "8d6",
                  "8d6",
                  "9d6",
                  "9d6",
                  "10d6",
                  "10d6"
                ]
              }
            }
          ]
        }
      ]
    }
  },
