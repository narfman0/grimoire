{
  "name": "grimoire",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node build",
    "check": "node scripts/check-drizzle.mjs && node scripts/rehearse-migrations.mjs && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node ./scripts/migrate.mjs",
    "migrate": "node ./scripts/migrate.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:unit": "vitest run --exclude 'src/lib/components/**'",
    "test:component": "vitest run src/lib/components",
    "test:watch": "vitest",
    "gaps": "node scripts/content-gaps.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@sveltejs/adapter-node": "^5.2.0",
    "@sveltejs/kit": "^2.5.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.4",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.10",
    "@types/node": "^22.20.1",
    "drizzle-kit": "^0.24.0",
    "jsdom": "^29.1.1",
    "pino-pretty": "^13.1.3",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.3",
    "tailwindcss": "^4.0.0",
    "tslib": "^2.6.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@sentry/sveltekit": "^10.53.1",
    "better-sqlite3": "^11.1.0",
    "drizzle-orm": "^0.33.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  }
}
