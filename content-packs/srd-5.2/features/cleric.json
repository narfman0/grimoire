      "ownerKind": "class",
      "ownerSlug": "cleric",
      "minLevel": 5,
      "note": "SRD 5.2: Whenever you use Turn Undead, roll a number of d8s equal to your Wisdom modifier; each undead that fails its save takes Radiant damage equal to the total. The die count is wismod (dynamic), not a fixed 2d8. The engine's damage parts schema only accepts a static dice string; surfaced as a trait tag so the UI can prompt the player to roll the correct number of d8s manually.",
      "modifiers": [
        {
          "kind": "stat-modifier",
          "target": "trait.sear-undead",
          "mode": "OVERRIDE",
