  {
    "kind": "feature",
    "slug": "evasion-rogue",
    "version": 1,
    "name": "Evasion",
    "data": {
      "ownerKind": "class",
      "ownerSlug": "rogue",
      "minLevel": 7,
      "modifiers": [
        {
          "kind": "stat-modifier",
          "target": "trait.evasion",
          "mode": "OVERRIDE",
          "value": true
        }
      ],
      "note": "When you are subjected to an effect that allows a DEX saving throw to take half damage, you instead take no damage on a success and half damage on a failure. v0 tags the trait; the split save-result behavior needs engine support to intercept the damage-from-dex-save path."
    }
  },
  {
    "kind": "feature",
    "slug": "improved-cunning-strike",
    "version": 1,
    "name": "Improved Cunning Strike",
    "data": {
      "ownerKind": "class",
      "ownerSlug": "rogue",
      "minLevel": 9,
      "note": "You can use up to two Cunning Strike effects when you deal Sneak Attack damage, and you can use Cunning Strike even if you forgo your Sneak Attack damage. v0 tags this upgrade; the two-maneuver concurrent spend isn't separately enforced by the engine beyond the existing Cunning Strike toggle rows.",
      "modifiers": [
        {
          "kind": "stat-modifier",
          "target": "trait.improved-cunning-strike",
          "mode": "OVERRIDE",
          "value": true
        }
      ]
    }
  },
  {
    "kind": "feature",
    "slug": "reliable-talent",
    "version": 1,
    "name": "Reliable Talent",
    "data": {
      "ownerKind": "class",
      "ownerSlug": "rogue",
      "minLevel": 11,
      "modifiers": [
        {
          "kind": "stat-modifier",
          "target": "trait.reliable-talent",
          "mode": "OVERRIDE",
          "value": true
        }
      ],
      "note": "Whenever you make an ability check using a skill or tool proficiency, you can treat a d20 roll of 9 or lower as a 10. v0 tags the trait; the die-floor behavior needs engine support in the dice roller (treat rolls ≤ 9 as 10 on proficient checks)."
    }
  },
  {
    "kind": "feature",
    "slug": "subtle-strikes",
    "version": 1,
    "name": "Subtle Strikes",
    "data": {
      "ownerKind": "class",
      "ownerSlug": "rogue",
      "minLevel": 13,
      "modifiers": [
        {
          "kind": "action-modifier",
          "id": "subtle-strikes-sneak-attack-vs-ally",
          "name": "Subtle Strikes",
          "defaultEnabled": true,
          "appliesTo": {
            "activityType": "attack",
            "predicates": [
              {
                "or": [
                  { "weapon.property": "finesse" },
                  { "attack.range": "ranged" }
                ]
              }
            ]
          },
          "effects": [
            {
              "target": "tag.subtle-strikes.sneak-attack-vs-ally-adjacent",
              "mode": "OVERRIDE",
              "value": true
            }
          ]
        }
      ],
      "note": "When you attack a creature, you don't need Advantage on the attack roll to use Sneak Attack if at least one ally of yours is within 5 feet of the creature — even if that ally has the Incapacitated condition. The existing 2024 Sneak Attack rule already covers the ally-adjacent case; Subtle Strikes additionally removes the need for the ally to be non-incapacitated. v0 tags this relaxation; the evaluator's advantage/ally-adjacency gate already allows ally-adjacent Sneak Attack — this just widens the ally eligibility."
    }
  },
