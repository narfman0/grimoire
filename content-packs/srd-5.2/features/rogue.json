    "name": "Thieves' Cant",
    "data": {
      "ownerKind": "class",
      "ownerSlug": "rogue",
      "minLevel": 1,
      "note": "You know Thieves' Cant, a secret mix of jargon, slang, and hand signs. The 2024 SRD also grants one additional language of your choice. v0 stores the language as a proficiency flag; language tracking isn't yet wired through derive.ts.",
      "modifiers": [
        {
          "kind": "stat-modifier",
          "target": "proficiency.language.thieves-cant",
          "mode": "OVERRIDE",
          "value": true
        }
      ]
    }
  },
  {
