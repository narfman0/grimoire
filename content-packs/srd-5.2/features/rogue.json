[
  {
    "kind": "feature",
    "slug": "expertise-rogue",
    "version": 1,
    "name": "Expertise (Rogue)",
    "data": {
      "ownerKind": "class",
      "ownerSlug": "rogue",
      "minLevel": 1,
      "note": "Choose 2 of your skill proficiencies; your proficiency bonus is doubled for any ability check you make that uses either of the chosen proficiencies. A third pick is added at Rogue 6. v0 derive.ts hard-codes expertise=false in the skills loop; the choice is surfaced for the editor but the doubled-PB bonus isn't yet emitted.",
      "choice": {
        "kind": "expertise",
        "pick": 2,
        "from": "proficient-skills"
      }
    }
  },
  {
    "kind": "feature",
    "slug": "sneak-attack",
    "version": 1,
    "name": "Sneak Attack",
    "data": {
      "ownerKind": "class",
      "ownerSlug": "rogue",
      "minLevel": 1,
      "note": "2024 SRD 5.2 Sneak Attack: once per turn, when you hit with an attack roll using a Finesse or Ranged weapon and either you have Advantage or an ally of the target is within 5 ft of it (and you don't have Disadvantage), deal extra damage. Scales by rogue level: [1d6,1d6,2d6,2d6,3d6,3d6,4d6,4d6,5d6,5d6,6d6,6d6,7d6,7d6,8d6,8d6,9d6,9d6,10d6,10d6]. v0 hard-codes the L1 +1d6 bonus and doesn't scale; engine-extension needed to: (a) read perClass/table for damage.bonus dice values, (b) enforce 'once per turn', (c) gate on advantage/ally-adjacency. The {or:[...]} predicate covers Finesse OR Ranged weapon classification.",
      "modifiers": [
        {
          "kind": "action-modifier",
          "id": "sneak-attack-damage",
          "name": "Sneak Attack",
          "defaultEnabled": true,
          "appliesTo": {
            "activityType": "attack",
            "predicates": [
              {
                "or": [
                  {
                    "weapon.property": "finesse"
                  },
                  {
                    "attack.range": "ranged"
                  }
                ]
              }
            ]
          },
          "effects": [
            {
              "target": "damage.bonus",
              "mode": "ADD",
              "value": "1d6"
            }
          ]
        }
      ]
    }
  },
  {
    "kind": "feature",
    "slug": "thieves-cant",
