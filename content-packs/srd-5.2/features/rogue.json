  {
    "kind": "feature",
    "slug": "cunning-strike",
    "version": 1,
    "name": "Cunning Strike",
    "data": {
      "ownerKind": "class",
      "ownerSlug": "rogue",
      "minLevel": 5,
      "note": "When you deal Sneak Attack damage, you can spend some of that damage (forgoing Sneak Attack dice) to add a maneuver effect. Available options at L5: Disarm (1d6), Poison (1d6), Trip (1d6), Withdraw (1d6). The die cost is forfeited from Sneak Attack dice. v0 surfaces each maneuver as a separate action-modifier toggle (defaultEnabled:false); the dice-spend accounting and the imposed saves/conditions are NOT simulated — engine extension needed.",
      "modifiers": [
        {
          "kind": "action-modifier",
          "id": "cunning-strike-disarm",
          "name": "Cunning Strike: Disarm",
          "defaultEnabled": false,
          "appliesTo": {
            "activityType": "attack",
            "predicates": [
              {
                "or": [
                  { "weapon.property": "finesse" },
                  { "attack.range": "ranged" }
                ]
              }
            ]
          },
          "effects": [
            {
              "target": "tag.cunning-strike.disarm",
              "mode": "OVERRIDE",
              "value": true
            }
          ]
        },
